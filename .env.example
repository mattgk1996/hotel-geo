# Copy to .env.local for local development. Never commit real values (this repo is public).

# Supabase → Project Settings → API (or the project's "Connect" dialog)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...) or legacy "anon" key — safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) or legacy "service_role" key — SERVER ONLY.
SUPABASE_SERVICE_ROLE_KEY=
# Random secret (>= 32 chars) mixed into every PIN before it reaches Supabase Auth — SERVER ONLY.
# Generate once, e.g. in the Supabase SQL editor: select encode(gen_random_bytes(32), 'base64');
# Changing it later invalidates every PIN (admin must reset them all).
PIN_PEPPER=

# Google AI Studio key for voucher reading — SERVER ONLY. Not needed until milestone 4.
GEMINI_API_KEY=

APP_TIMEZONE=Asia/Kolkata
